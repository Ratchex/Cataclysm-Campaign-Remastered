-- Somtaaw Worker animation states (Cataclysm-HWRM; installed over Cataclysm Remastered's by tools/install_cr.py).
-- Clips from Cataclysm's sworker.mad (tools/mad2hwrm.py): JackOut / JackClose swing the repair jack out and back,
-- JackSpin holds it out, DockOpen / DockClose turn the four docking clamps, BladesSpin turns the three blades.
-- Effects (.events): "Resourcing" = stock HW1 harvest beam at marker_beam, "Repairing" = stock repair beam at
-- marker_repair (the jackhammer tip). A clip paused at 1000 s holds its last frame (Cataclysm Remastered's pattern).

-- start clip "to"; if its opposite "from" is still running, from the matching point so the part doesn't jump
SMT_WORKER_Swap = function(ship, from, to)
    if(isAnimRunning(ship, to) == 0) then
        startTime = 0
        if(isAnimRunning(ship, from) ~= 0) then
            startTime = getAnimLength(ship, from) - getTime(ship, from)
            if(startTime < 0) then
                startTime = 0
            end
            stopAnim(ship, from)
        end
        startAnim(ship, to)
        setTime(ship, to, startTime)
        setPauseTime(ship, to, 1000)
    end
end

-- DOCKING: clamps out while latched to the Kuun-Lan, stowed in flight -----------
-- Workers whose clamps are out; a ship that never opened them (spawned in flight) does not play DockClose, which
-- starts from the open pose.
SMT_WORKER_ClampsOut = {}

SMT_WORKER_OpenClamps = function(ship)
    SMT_WORKER_Swap(ship, "DockClose", "DockOpen")
    SMT_WORKER_ClampsOut[ship] = 1
end

SMT_WORKER_CloseClamps = function(ship)
    if(SMT_WORKER_ClampsOut[ship]) then
        SMT_WORKER_Swap(ship, "DockOpen", "DockClose")
        SMT_WORKER_ClampsOut[ship] = nil
    end
end

SMT_WORKER_Launched_OnSet = function(ship)
    SMT_WORKER_CloseClamps(ship)
end

SMT_WORKER_Docked_OnSet = function(ship)
    SMT_WORKER_OpenClamps(ship)
end

-- cutscenes: Cataclysm's NIS "meshAnimStart <clip>" (tools/nis2hwrm.py NIS_STATES: DockOpen = NIS00,
-- DockClose = NIS01)
SMT_WORKER_NIS00_OnSet = function(ship)
    SMT_WORKER_OpenClamps(ship)
end

SMT_WORKER_NIS01_OnSet = function(ship)
    SMT_WORKER_CloseClamps(ship)
end

-- RESOURCE COLLECTION: boom out (as for repairs), harvest beam, blades turning ----
SMT_WORKER_ResourceStart_OnSet = function(ship)
    -- held until the boom is out (ResourceStart_OnPause), as for repairs: the beam starts at its tip
    setState(ship, "ResourceStart", 0)
    endEffect(ship, "Resourcing")
    SMT_WORKER_Swap(ship, "JackClose", "JackOut")
end

SMT_WORKER_ResourceStart_OnPause = function(ship)
    setState(ship, "ResourceStart", 1)
end

SMT_WORKER_ResourceDo_OnSet = function(ship)
    SMT_WORKER_Swap(ship, "JackClose", "JackOut")
    if(isAnimRunning(ship, "BladesSpin") == 0) then
        startAnim(ship, "BladesSpin")
    end
    startEffect(ship, "Resourcing")
    setState(ship, "ResourceDo", 1)
end

SMT_WORKER_ResourceEnd_OnSet = function(ship)
    stopAnim(ship, "BladesSpin")
    SMT_WORKER_Swap(ship, "JackOut", "JackClose")
    endEffect(ship, "Resourcing")
    setState(ship, "ResourceEnd", 1)
end

-- REPAIRING: jack swings out, repair beam from its tip, jack swings back -----------
SMT_WORKER_RepairStart_OnSet = function(ship)
    -- held until the jack is out (RepairStart_OnPause)
    setState(ship, "RepairStart", 0)
    endEffect(ship, "Repairing")
    SMT_WORKER_Swap(ship, "JackClose", "JackOut")
end

SMT_WORKER_RepairStart_OnPause = function(ship)
    setState(ship, "RepairStart", 1)
end

SMT_WORKER_RepairDo_OnSet = function(ship)
    SMT_WORKER_Swap(ship, "JackClose", "JackOut")
    startEffect(ship, "Repairing")
    setState(ship, "RepairDo", 1)
end

SMT_WORKER_RepairEnd_OnSet = function(ship)
    endEffect(ship, "Repairing")
    SMT_WORKER_Swap(ship, "JackOut", "JackClose")
    setState(ship, "RepairEnd", 1)
end

-- SCRIPTED REPAIR (shiprules.lua CatRepair_Tick heals; HWRM's own repair states never come, its order doesn't
-- latch): SobGroup_SetMadState passes on only engine state names, so NIS02 = jack out and repair cone on,
-- DockPathOpen1 = cone off and jack back (the Worker has no dock paths of its own)
SMT_WORKER_NIS02_OnSet = function(ship)
    SMT_WORKER_Swap(ship, "JackClose", "JackOut")
    startEffect(ship, "Repairing")
end

SMT_WORKER_DockPathOpen1_OnSet = function(ship)
    endEffect(ship, "Repairing")
    SMT_WORKER_Swap(ship, "JackOut", "JackClose")
end

-- CAPTURING: the jack, as Cataclysm Remastered's extend / retract ----------------
SMT_WORKER_CaptureActive_OnSet = function(ship)
    setState(ship, "CaptureActive", 0)
    SMT_WORKER_Swap(ship, "JackClose", "JackOut")
end

SMT_WORKER_CaptureInActive_OnSet = function(ship)
    setState(ship, "CaptureActive", 1)
    SMT_WORKER_Swap(ship, "JackOut", "JackClose")
end
