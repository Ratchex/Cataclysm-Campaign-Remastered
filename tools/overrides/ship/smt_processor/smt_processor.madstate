-- Somtaaw Processor animation states (Cataclysm-HWRM; installed by tools/install_cr.py).
-- Its four repair beam cones (tools/make_procbeam.py), aimed here at what shiprules.lua CatProcessor_Tick repairs.
-- That script can't reach this Lua state (no shared globals), only switch the state: it sends bits, each a switch
-- to one of the two of NIS00-02 it is not in (NIS00-02: the only states the engine leaves alone on the Processor;
-- its dock paths use the DockPath ones). 14 bits a message: beam (2), band (2: 0 off, 1-3 the cone's length),
-- yaw (5), pitch (5: 0-31 over -45..45 degrees). Messages are sent whole within one script update; the Clock clip's
-- time tells updates apart, so a message cut short (a lost bit) is dropped at the next update.
-- Aim: clip Yaw<i> / Pitch<i> sweeps -45..45 over 0..1 s and back over 1..2 s; a turn plays the half that goes
-- the right way from the current angle and pauses at the new one (90 degrees a second), so the engine moves it
-- smoothly between the script's updates.

SMT_PROCESSOR_P = {}
SMT_PROCESSOR_RANGE = 45
SMT_PROCESSOR_LEVELS = 31

SMT_PROCESSOR_Angle = function(ship, clip)
    if(isAnimRunning(ship, clip) == 0) then
        return 0
    end
    local t = getTime(ship, clip)
    if(t <= 1) then
        return -SMT_PROCESSOR_RANGE + 2 * SMT_PROCESSOR_RANGE * t
    end
    return SMT_PROCESSOR_RANGE - 2 * SMT_PROCESSOR_RANGE * (t - 1)
end

SMT_PROCESSOR_Aim = function(ship, clip, target)
    local a = SMT_PROCESSOR_Angle(ship, clip)
    local d = target - a
    if(d < 0.5 and d > -0.5) then
        return
    end
    local w = 2 * SMT_PROCESSOR_RANGE
    local t0 = 0
    local t1 = 0
    if(d > 0) then
        t0 = (a + SMT_PROCESSOR_RANGE) / w
        t1 = (target + SMT_PROCESSOR_RANGE) / w
    else
        t0 = 1 + (SMT_PROCESSOR_RANGE - a) / w
        t1 = 1 + (SMT_PROCESSOR_RANGE - target) / w
    end
    if(isAnimRunning(ship, clip) ~= 0) then
        stopAnim(ship, clip)
    end
    startAnim(ship, clip)
    setTime(ship, clip, t0)
    setPauseTime(ship, clip, t1)
end

SMT_PROCESSOR_Value = function(bits, first, count)
    local v = 0
    for k = first, first + count - 1 do
        v = v * 2 + bits[k]
    end
    return v
end

SMT_PROCESSOR_Message = function(ship, p)
    local beam = SMT_PROCESSOR_Value(p.bits, 1, 2)
    local band = SMT_PROCESSOR_Value(p.bits, 3, 2)
    local yaw = SMT_PROCESSOR_Value(p.bits, 5, 5) * 2 * SMT_PROCESSOR_RANGE / SMT_PROCESSOR_LEVELS - SMT_PROCESSOR_RANGE
    local pitch = SMT_PROCESSOR_Value(p.bits, 10, 5) * 2 * SMT_PROCESSOR_RANGE / SMT_PROCESSOR_LEVELS - SMT_PROCESSOR_RANGE
    local old = p.band[beam] or 0
    if(old ~= band) then
        if(old > 0) then
            endEffect(ship, "ProcBeam" .. beam .. "_" .. old)
        end
        if(band > 0) then
            startEffect(ship, "ProcBeam" .. beam .. "_" .. band)
        end
        p.band[beam] = band
    end
    if(band > 0) then
        SMT_PROCESSOR_Aim(ship, "Yaw" .. beam, yaw)
        SMT_PROCESSOR_Aim(ship, "Pitch" .. beam, pitch)
    end
end

SMT_PROCESSOR_Symbol = function(ship, sym)
    local p = SMT_PROCESSOR_P[ship]
    if(p == nil) then
        p = { bits = {}, n = 0, band = {} }
        SMT_PROCESSOR_P[ship] = p
    end
    if(isAnimRunning(ship, "Clock") == 0) then
        startAnim(ship, "Clock")
    end
    local now = getTime(ship, "Clock")
    if(p.clock ~= now) then
        p.clock = now
        p.n = 0
    end
    if(p.prev == nil) then
        p.prev = sym
        return
    end
    local bit = sym - p.prev - 1
    if(bit < 0) then
        bit = bit + 3
    end
    p.prev = sym
    p.n = p.n + 1
    p.bits[p.n] = bit
    if(p.n == 14) then
        SMT_PROCESSOR_Message(ship, p)
        p.n = 0
    end
end

SMT_PROCESSOR_NIS00_OnSet = function(ship)
    SMT_PROCESSOR_Symbol(ship, 0)
end

SMT_PROCESSOR_NIS01_OnSet = function(ship)
    SMT_PROCESSOR_Symbol(ship, 1)
end

SMT_PROCESSOR_NIS02_OnSet = function(ship)
    SMT_PROCESSOR_Symbol(ship, 2)
end
