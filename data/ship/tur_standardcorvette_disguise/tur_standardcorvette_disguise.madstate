-- Generated by tools/make_disguise.py: the pirate corvette's body and its disguises (joints of its model),
-- one shown at a time: NIS00 the corvette, NIS01... a disguise (cataclysmkas.lua K_497fd0 / K_498080).
TUR_STANDARDCORVETTE_DISGUISE_Show = function(ship, shown)
    if(shown == "MimicBody") then setJointVisible(ship, "MimicBody_P1StandardCorvette", 1) else setJointVisible(ship, "MimicBody_P1StandardCorvette", 0) end
    if(shown == "MimicBody") then setJointVisible(ship, "MimicBody_Weapon_Gun0_Position", 1) else setJointVisible(ship, "MimicBody_Weapon_Gun0_Position", 0) end
    if(shown == "MimicBody") then setJointVisible(ship, "MimicBody_Weapon_Gun1_Position", 1) else setJointVisible(ship, "MimicBody_Weapon_Gun1_Position", 0) end
    if(shown == "Disguise_kadvancesupportfrigate_0") then setJointVisible(ship, "Disguise_kadvancesupportfrigate_0", 1) else setJointVisible(ship, "Disguise_kadvancesupportfrigate_0", 0) end
    if(shown == "Disguise_djunk3boiler_2") then setJointVisible(ship, "Disguise_djunk3boiler_2", 1) else setJointVisible(ship, "Disguise_djunk3boiler_2", 0) end
    if(shown == "Disguise_djunk2shipwreck_2") then setJointVisible(ship, "Disguise_djunk2shipwreck_2", 1) else setJointVisible(ship, "Disguise_djunk2shipwreck_2", 0) end
    if(shown == "Disguise_djunk1shell_2") then setJointVisible(ship, "Disguise_djunk1shell_2", 1) else setJointVisible(ship, "Disguise_djunk1shell_2", 0) end
    if(shown == "Disguise_djunk1parta_2") then setJointVisible(ship, "Disguise_djunk1parta_2", 1) else setJointVisible(ship, "Disguise_djunk1parta_2", 0) end
    if(shown == "Disguise_tresourcecollector_3") then setJointVisible(ship, "Disguise_tresourcecollector_3", 1) else setJointVisible(ship, "Disguise_tresourcecollector_3", 0) end
    if(shown == "Disguise_a1_0") then setJointVisible(ship, "Disguise_a1_0", 1) else setJointVisible(ship, "Disguise_a1_0", 0) end
    if(shown == "Disguise_sacolyte_0") then setJointVisible(ship, "Disguise_sacolyte_0", 1) else setJointVisible(ship, "Disguise_sacolyte_0", 0) end
    if(shown == "Disguise_p1fighter_5") then setJointVisible(ship, "Disguise_p1fighter_5", 1) else setJointVisible(ship, "Disguise_p1fighter_5", 0) end
end

TUR_STANDARDCORVETTE_DISGUISE_NIS00_OnSet = function(ship)
    TUR_STANDARDCORVETTE_DISGUISE_Show(ship, "MimicBody")
end

TUR_STANDARDCORVETTE_DISGUISE_NIS01_OnSet = function(ship)
    TUR_STANDARDCORVETTE_DISGUISE_Show(ship, "Disguise_kadvancesupportfrigate_0")
end

