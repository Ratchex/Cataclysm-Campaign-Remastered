-- Somtaaw Processor animation states (Cataclysm-HWRM; installed by tools/install_base.py).
-- Its four repair beam cones (tools/make_procbeam.py), aimed here at what shiprules.lua CatProcessor_Tick repairs.
-- That script can't reach this Lua state (no shared globals), only switch the state: it sends bits, each a switch
-- to one of the two of NIS00-02 it is not in (NIS00-02: the only states the engine leaves alone on the Processor;
-- its dock paths use the DockPath ones). 24 bits a message: beam (2), band (2: 0 off, 1-3 the cone's length),
-- yaw (8), pitch (8: 0-255 over -45..45 degrees), check (4: shiprules.lua CatProcBeam_Check; a message that fails
-- it is dropped and the rest of that update ignored). Messages are sent whole within one script update; the Clock clip's
-- time tells updates apart, so a message cut short (a lost bit) is dropped at the next update.
-- Aim: clip Yaw<i> / Pitch<i> sweeps -45..45 and back once per speed tier (make_procbeam.py); the script turns
-- the turret itself (like a stock ion turret) and sends its angle as it changes. A turret standing still is posed
-- at it (time set, clip paused). A moving one (its speed from its last two angles over the Clock clip's time, so
-- the engine's own playback rate cancels out) plays the slowest tier at least as fast as it, from its angle toward
-- where that speed takes it by the next message, so it moves between the script's updates (10 a second) instead of
-- stepping (user: it doesn't update smoothly).

SMT_PROCESSOR_P = {}
SMT_PROCESSOR_RANGE = 45
SMT_PROCESSOR_LEVELS = 255
SMT_PROCESSOR_SWEEP = { Yaw = 90 / 35, Pitch = 90 / 20 }   -- seconds per sweep one way (make_procbeam.py)
SMT_PROCESSOR_TIERS = 9                                     -- (make_procbeam.py TIERS, TIER_STEP)
SMT_PROCESSOR_STEP = 1.5
SMT_PROCESSOR_STALE = 0.6                                   -- clock seconds after which a last angle is too old

-- a clip time on tier k's sweep (k 0: the ion turret's rate) at angle a, going up (dir 1) or down (dir -1)
SMT_PROCESSOR_Time = function(sweep, k, dir, a)
    local t, s = 0, sweep
    for j = 1, k do
        t = t + 2 * s
        s = s * SMT_PROCESSOR_STEP
    end
    local f = (a + SMT_PROCESSOR_RANGE) / (2 * SMT_PROCESSOR_RANGE)
    if(dir > 0) then
        return t + f * s
    end
    return t + s + (1 - f) * s
end

SMT_PROCESSOR_Aim = function(ship, p, clip, sweep, target)
    if(isAnimRunning(ship, clip) == 0) then
        startAnim(ship, clip)
    end
    local last = p.last[clip]
    p.last[clip] = { target, p.clock }
    local v, dt = 0, 0
    if(last ~= nil) then
        dt = p.clock - last[2]
        if(dt > 0 and dt < SMT_PROCESSOR_STALE) then
            v = (target - last[1]) / dt
        end
    end
    if(v ~= 0) then
        local dir, sp = 1, v
        if(v < 0) then
            dir, sp = -1, -v
        end
        local k, rate = 0, 2 * SMT_PROCESSOR_RANGE / sweep
        while(k + 1 < SMT_PROCESSOR_TIERS and rate / SMT_PROCESSOR_STEP >= sp) do
            k = k + 1
            rate = rate / SMT_PROCESSOR_STEP
        end
        local to = target + v * dt                         -- where it will be by the next message
        if(to > SMT_PROCESSOR_RANGE) then
            to = SMT_PROCESSOR_RANGE
        elseif(to < -SMT_PROCESSOR_RANGE) then
            to = -SMT_PROCESSOR_RANGE
        end
        unpauseAnim(ship, clip)
        setTime(ship, clip, SMT_PROCESSOR_Time(sweep, k, dir, target))
        setPauseTime(ship, clip, SMT_PROCESSOR_Time(sweep, k, dir, to))
        return
    end
    local t = SMT_PROCESSOR_Time(sweep, 0, 1, target)
    -- frozen at the angle: unpaused, set and paused again within this call, so no frame plays in between. (Only a
    -- pause point a hair after the angle, as before, was sometimes skipped: the clip played on through its sweep
    -- until the next message snapped it back, user: still oscillating with both ships stopped. A pause point at the
    -- angle itself didn't pause; 0.02 s short twitched every update.) The pause point stays as a backstop.
    unpauseAnim(ship, clip)
    setTime(ship, clip, t)
    setPauseTime(ship, clip, t + 0.001)
    pauseAnim(ship, clip)
end

SMT_PROCESSOR_Value = function(bits, first, count)
    local v = 0
    for k = first, first + count - 1 do
        v = v * 2 + bits[k]
    end
    return v
end

SMT_PROCESSOR_Message = function(ship, p)
    local beam = SMT_PROCESSOR_Value(p.bits, 1, 2)
    local band = SMT_PROCESSOR_Value(p.bits, 3, 2)
    local yq = SMT_PROCESSOR_Value(p.bits, 5, 8)
    local pq = SMT_PROCESSOR_Value(p.bits, 13, 8)
    -- shiprules.lua CatProcBeam_Check, without floor (this Lua state may lack it): the high nibbles from the bits
    local c = beam * 7 + band * 5 + yq * 3 + pq + SMT_PROCESSOR_Value(p.bits, 5, 4) + SMT_PROCESSOR_Value(p.bits, 13, 4) * 9
    while(c >= 16) do
        c = c - 16
    end
    if(SMT_PROCESSOR_Value(p.bits, 21, 4) ~= c) then
        print("CATACLYSM procbeam: a message failed its check, the rest of this update dropped")
        p.skip = p.clock
        return
    end
    local yaw = yq * 2 * SMT_PROCESSOR_RANGE / SMT_PROCESSOR_LEVELS - SMT_PROCESSOR_RANGE
    local pitch = pq * 2 * SMT_PROCESSOR_RANGE / SMT_PROCESSOR_LEVELS - SMT_PROCESSOR_RANGE
    local old = p.band[beam] or 0
    if(old ~= band) then
        if(old > 0) then
            endEffect(ship, "ProcBeam" .. beam .. "_" .. old)
        end
        if(band > 0) then
            startEffect(ship, "ProcBeam" .. beam .. "_" .. band)
        end
        p.band[beam] = band
    end
    SMT_PROCESSOR_Aim(ship, p, "Yaw" .. beam, SMT_PROCESSOR_SWEEP.Yaw, yaw)
    SMT_PROCESSOR_Aim(ship, p, "Pitch" .. beam, SMT_PROCESSOR_SWEEP.Pitch, pitch)
end

SMT_PROCESSOR_Symbol = function(ship, sym)
    local p = SMT_PROCESSOR_P[ship]
    if(p == nil) then
        p = { bits = {}, n = 0, band = {}, last = {} }
        SMT_PROCESSOR_P[ship] = p
    end
    if(isAnimRunning(ship, "Clock") == 0) then
        startAnim(ship, "Clock")
    end
    local now = getTime(ship, "Clock")
    if(p.clock ~= now) then
        p.clock = now
        p.n = 0
    end
    if(p.prev == nil) then
        p.prev = sym
        return
    end
    local bit = sym - p.prev - 1
    if(bit < 0) then
        bit = bit + 3
    end
    p.prev = sym
    if(p.skip == p.clock) then
        return
    end
    p.n = p.n + 1
    p.bits[p.n] = bit
    if(p.n == 24) then
        SMT_PROCESSOR_Message(ship, p)
        p.n = 0
    end
end

SMT_PROCESSOR_NIS00_OnSet = function(ship)
    SMT_PROCESSOR_Symbol(ship, 0)
end

SMT_PROCESSOR_NIS01_OnSet = function(ship)
    SMT_PROCESSOR_Symbol(ship, 1)
end

SMT_PROCESSOR_NIS02_OnSet = function(ship)
    SMT_PROCESSOR_Symbol(ship, 2)
end
