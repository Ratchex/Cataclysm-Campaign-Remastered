-- Homeworld: Cataclysm campaign for Homeworld Remastered (Stage A, local port).
-- Mod campaigns are "Extra" content (contentType 2), following the stock rr_oem.campaign and the
-- Taiidan Republic mod. The campaign list tile is leveldata/campaign/cataclysm.dds (1024x512);
-- per-mission thumbnails live in ui/mapthumbnails/campaign/cataclysm/<directory>.dds.
--
-- Fleet carry-over: winning Mission[n] (hyperspace, setMissionComplete(1)) makes the engine write the fleet in
-- hyperspace to <profile>/Campaign/CATACLYSM/persist<n+1>.lua, which Mission[n+1] loads. So Mission[n] is Cataclysm's
-- Mission n, in order with no gaps, and the unit test range stays after the last mission.
-- Animatics follow HWRM's HW1 campaign: Mission[n].postload plays AnimaticNN (the one before mission n).

displayName = "Homeworld Cataclysm"

-- 2 = Extra
contentType = 2
contentName = "cataclysm" -- must match the directory name
contentOrdered = 0 -- unlocked while porting; set to 1 for release
contentChooseText = "CHOOSE MISSION"
contentThumbName = "Homeworld Cataclysm"
contentThumbDesc = "The Kuun-Lan and Kiith Somtaaw against the Beast."
contentSort = 0.3

Mission = {}

-- Cataclysm Mission01, translated from cataclysm.exe.
Mission[1] =
{
    postload    = function () playAnimatic("data:animatics/animatic01.lua", 0, 0) end,
    directory   = "m01",
    level       = "m01.level",
    postlevel   = function ( bWin ) postLevelComplete() end,

    displayName = "Mission 1 (translated)",
    description = "Cataclysm Mission01 running on translated mission code.",
}

-- Cataclysm Mission02 (not ported yet; uncomment with its level). Loads persist2.lua, Mission 1's fleet.
-- Mission[2] =
-- {
--     postload    = function () playAnimatic("data:animatics/animatic02.lua", 0, 0) end,
--     directory   = "m02",
--     level       = "m02.level",
--     postlevel   = function ( bWin ) postLevelComplete() end,
--
--     displayName = "Mission 2 (translated)",
--     description = "Cataclysm Mission02 running on translated mission code.",
-- }

-- Unit test range: Somtaaw ships and systems away from the missions (range/range.lua has its switches).
-- Keep it last (after the highest ported mission) so it never sits between two missions' carry-over.
Mission[2] =
{
    directory   = "range",
    level       = "range.level",
    postlevel   = function ( bWin ) postLevelComplete() end,

    displayName = "Unit test range",
    description = "The Kuun-Lan, Acolytes, ACVs, Workers and a Recon, with Taiidan targets. All research done.",
}
