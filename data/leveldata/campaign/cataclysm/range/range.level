-- Unit test range (hand-written, not from a Cataclysm mission): the Kuun-Lan, a few of each Somtaaw ship ported so
-- far, asteroids for the Workers and Taiidan targets at three distances. Script: range.lua.

function DetermChunk()
    addPoint("StartPos0", {0, 0, 0}, {0, 0, 0})
    addPoint("StartPos1", {0, 0, 9000}, {0, 180, 0})

    addSquadron("KuunLan", "smt_ms_sp", {0, 0, 0}, 0, {0, 0, 0}, 0, 0)
    -- strike craft in rows ahead of the Kuun-Lan (+Z)
    for i = 0, 7 do
        addSquadron("Acolyte" .. i, "smt_acolyte", {-700 + i * 200, 0, 2200}, 0, {0, 0, 0}, 0, 0)
    end
    createSOBGroup("Workers")
    for i = 0, 1 do
        addSquadron("ACV" .. i, "smt_acv", {-300 + i * 600, 0, 2600}, 0, {0, 0, 0}, 0, 0)
        addSquadron("Worker" .. i, "smt_worker", {-1800 + i * 400, 0, 1200}, 0, {0, 0, 0}, 0, 0)
        addToSOBGroup("Worker" .. i, "Workers")
    end
    -- the Processor (repair beams) to starboard, a Ramming Frigate beside the ACVs
    addSquadron("Processor0", "smt_processor", {1900, 0, 1200}, 0, {0, 0, 0}, 0, 0)
    addSquadron("RammingFrigate0", "smt_rammingfrigate", {1100, 0, 2600}, 0, {0, 0, 0}, 0, 0)
    -- tilted (pitch 20, yaw 50, roll 10): the orientation-matrix layout check in range.lua
    addSquadron("Recon0", "smt_scout", {0, 300, 2900}, 0, {20, 50, 10}, 0, 0)
    createSOBGroup("Recon")
    addToSOBGroup("Recon0", "Recon")

    -- asteroids off the port side
    for row = 0, 1 do
        for i = 0, 3 do
            addAsteroid("Asteroid2", {-4500 - i * 450, -200 + row * 400, 1500 + (row * 4 + i) * 250}, 400,
                        37 * i, 61 * row, 23 * i, 0)
        end
    end

    -- targets (player 1, its AI off): punching bags close, a strike group further out, frigates at long range
    -- a meteor belt (Mission02's MeteorStorm mechanics, cataclysmkas.lua KAS_Meteor*; range.lua RANGE_METEORS): 24
    -- meteors of every size flowing +x at Mission02's speed across z 3500-4500, wrapped at x +-7000 (player 3)
    createSOBGroup("KAS_Meteors0")
    addSquadron("KAS_Meteors0_0", "cat_meteor1", {-7088, -37, 4163}, 3, {174, 286, 338}, 0, 0)
    addToSOBGroup("KAS_Meteors0_0", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_0g")
    addToSOBGroup("KAS_Meteors0_0", "KAS_Meteors0_0g")
    addSquadron("KAS_Meteors0_1", "cat_meteor1", {-6408, 33, 4053}, 3, {119, 63, 333}, 0, 0)
    addToSOBGroup("KAS_Meteors0_1", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_1g")
    addToSOBGroup("KAS_Meteors0_1", "KAS_Meteors0_1g")
    addSquadron("KAS_Meteors0_2", "cat_meteor1", {-5828, 30, 3586}, 3, {255, 59, 113}, 0, 0)
    addToSOBGroup("KAS_Meteors0_2", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_2g")
    addToSOBGroup("KAS_Meteors0_2", "KAS_Meteors0_2g")
    addSquadron("KAS_Meteors0_3", "cat_meteor1", {-5270, 39, 4209}, 3, {2, 352, 288}, 0, 0)
    addToSOBGroup("KAS_Meteors0_3", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_3g")
    addToSOBGroup("KAS_Meteors0_3", "KAS_Meteors0_3g")
    addSquadron("KAS_Meteors0_4", "cat_meteor1", {-4645, 169, 3823}, 3, {183, 178, 349}, 0, 0)
    addToSOBGroup("KAS_Meteors0_4", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_4g")
    addToSOBGroup("KAS_Meteors0_4", "KAS_Meteors0_4g")
    addSquadron("KAS_Meteors0_5", "cat_meteor1", {-3976, -156, 3823}, 3, {144, 116, 109}, 0, 0)
    addToSOBGroup("KAS_Meteors0_5", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_5g")
    addToSOBGroup("KAS_Meteors0_5", "KAS_Meteors0_5g")
    addSquadron("KAS_Meteors0_6", "cat_meteor1", {-3672, 165, 4072}, 3, {303, 260, 336}, 0, 0)
    addToSOBGroup("KAS_Meteors0_6", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_6g")
    addToSOBGroup("KAS_Meteors0_6", "KAS_Meteors0_6g")
    addSquadron("KAS_Meteors0_7", "cat_meteor1", {-2950, -73, 3789}, 3, {106, 57, 335}, 0, 0)
    addToSOBGroup("KAS_Meteors0_7", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_7g")
    addToSOBGroup("KAS_Meteors0_7", "KAS_Meteors0_7g")
    addSquadron("KAS_Meteors0_8", "cat_meteor2", {-2363, 106, 3963}, 3, {55, 151, 104}, 0, 0)
    addToSOBGroup("KAS_Meteors0_8", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_8g")
    addToSOBGroup("KAS_Meteors0_8", "KAS_Meteors0_8g")
    addSquadron("KAS_Meteors0_9", "cat_meteor2", {-1643, 244, 4481}, 3, {46, 276, 138}, 0, 0)
    addToSOBGroup("KAS_Meteors0_9", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_9g")
    addToSOBGroup("KAS_Meteors0_9", "KAS_Meteors0_9g")
    addSquadron("KAS_Meteors0_10", "cat_meteor2", {-1230, 90, 4345}, 3, {21, 223, 332}, 0, 0)
    addToSOBGroup("KAS_Meteors0_10", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_10g")
    addToSOBGroup("KAS_Meteors0_10", "KAS_Meteors0_10g")
    addSquadron("KAS_Meteors0_11", "cat_meteor2", {-395, -271, 3573}, 3, {198, 27, 64}, 0, 0)
    addToSOBGroup("KAS_Meteors0_11", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_11g")
    addToSOBGroup("KAS_Meteors0_11", "KAS_Meteors0_11g")
    addSquadron("KAS_Meteors0_12", "cat_meteor2", {76, 6, 3612}, 3, {272, 313, 107}, 0, 0)
    addToSOBGroup("KAS_Meteors0_12", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_12g")
    addToSOBGroup("KAS_Meteors0_12", "KAS_Meteors0_12g")
    addSquadron("KAS_Meteors0_13", "cat_meteor2", {584, 237, 4379}, 3, {225, 76, 4}, 0, 0)
    addToSOBGroup("KAS_Meteors0_13", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_13g")
    addToSOBGroup("KAS_Meteors0_13", "KAS_Meteors0_13g")
    addSquadron("KAS_Meteors0_14", "cat_meteor2", {1324, 4, 4431}, 3, {166, 83, 126}, 0, 0)
    addToSOBGroup("KAS_Meteors0_14", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_14g")
    addToSOBGroup("KAS_Meteors0_14", "KAS_Meteors0_14g")
    addSquadron("KAS_Meteors0_15", "cat_meteor2", {1696, -62, 3939}, 3, {170, 148, 213}, 0, 0)
    addToSOBGroup("KAS_Meteors0_15", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_15g")
    addToSOBGroup("KAS_Meteors0_15", "KAS_Meteors0_15g")
    addSquadron("KAS_Meteors0_16", "cat_meteor3", {2399, -292, 3992}, 3, {81, 51, 200}, 0, 0)
    addToSOBGroup("KAS_Meteors0_16", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_16g")
    addToSOBGroup("KAS_Meteors0_16", "KAS_Meteors0_16g")
    addSquadron("KAS_Meteors0_17", "cat_meteor3", {2897, 159, 3519}, 3, {211, 15, 271}, 0, 0)
    addToSOBGroup("KAS_Meteors0_17", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_17g")
    addToSOBGroup("KAS_Meteors0_17", "KAS_Meteors0_17g")
    addSquadron("KAS_Meteors0_18", "cat_meteor3", {3543, 133, 3527}, 3, {267, 144, 9}, 0, 0)
    addToSOBGroup("KAS_Meteors0_18", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_18g")
    addToSOBGroup("KAS_Meteors0_18", "KAS_Meteors0_18g")
    addSquadron("KAS_Meteors0_19", "cat_meteor3", {3940, -71, 4043}, 3, {171, 84, 71}, 0, 0)
    addToSOBGroup("KAS_Meteors0_19", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_19g")
    addToSOBGroup("KAS_Meteors0_19", "KAS_Meteors0_19g")
    addSquadron("KAS_Meteors0_20", "cat_meteor3", {4675, 161, 3854}, 3, {188, 151, 208}, 0, 0)
    addToSOBGroup("KAS_Meteors0_20", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_20g")
    addToSOBGroup("KAS_Meteors0_20", "KAS_Meteors0_20g")
    addSquadron("KAS_Meteors0_21", "cat_meteor3", {5196, -9, 4363}, 3, {346, 217, 182}, 0, 0)
    addToSOBGroup("KAS_Meteors0_21", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_21g")
    addToSOBGroup("KAS_Meteors0_21", "KAS_Meteors0_21g")
    addSquadron("KAS_Meteors0_22", "cat_meteor4", {5844, -29, 3509}, 3, {185, 231, 8}, 0, 0)
    addToSOBGroup("KAS_Meteors0_22", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_22g")
    addToSOBGroup("KAS_Meteors0_22", "KAS_Meteors0_22g")
    addSquadron("KAS_Meteors0_23", "cat_meteor4", {6526, -3, 3788}, 3, {265, 287, 189}, 0, 0)
    addToSOBGroup("KAS_Meteors0_23", "KAS_Meteors0")
    createSOBGroup("KAS_Meteors0_23g")
    addToSOBGroup("KAS_Meteors0_23", "KAS_Meteors0_23g")

    addSquadron("TargetCollector0", "tai_resourcecollector", {1500, 0, 5000}, 1, {0, 180, 0}, 0, 0)
    addSquadron("TargetCollector1", "tai_resourcecollector", {2100, 0, 5000}, 1, {0, 180, 0}, 0, 0)
    for i = 0, 3 do
        addSquadron("TargetFighter" .. i, "tai_interceptor", {-2400 + i * 250, 0, 6500}, 1, {0, 180, 0}, 0, 0)
    end
    addSquadron("TargetCorvette0", "tai_heavycorvette", {-1300, 0, 6800}, 1, {0, 180, 0}, 0, 0)
    addSquadron("TargetCorvette1", "tai_lightcorvette", {-1000, 0, 6800}, 1, {0, 180, 0}, 0, 0)
    addSquadron("TargetFrigate0", "tai_assaultfrigate", {-500, 0, 9000}, 1, {0, 180, 0}, 0, 0)
    addSquadron("TargetFrigate1", "tai_ioncannonfrigate", {500, 0, 9000}, 1, {0, 180, 0}, 0, 0)
    createSOBGroup("TargetIon")
    addToSOBGroup("TargetFrigate1", "TargetIon")
    -- its 10 % damage copy (tools/make_variants.py), for the beam test in range.lua
    addSquadron("TargetFrigate2", "tai_ioncannonfrigate_d10", {1500, 0, 9000}, 1, {0, 180, 0}, 0, 0)
    createSOBGroup("TargetIon10")
    addToSOBGroup("TargetFrigate2", "TargetIon10")

    -- Mission01's crippled heavy cruiser (its 10 % damage copy) side by side with a sound one (range.lua
    -- RANGE_CRUISER_TEST: turret tracking at 20 % health, user)
    addSquadron("TargetCruiser0", "tai_heavycruiser_d10", {-1500, 0, 12000}, 1, {0, 180, 0}, 0, 0)
    createSOBGroup("TargetCruiserSound")
    addToSOBGroup("TargetCruiser0", "TargetCruiserSound")
    addSquadron("TargetCruiser1", "tai_heavycruiser_d10", {1500, 0, 12000}, 1, {0, 180, 0}, 0, 0)
    createSOBGroup("TargetCruiserCrippled")
    addToSOBGroup("TargetCruiser1", "TargetCruiserCrippled")

    -- a hostile Kushan destroyer flying the same way (user: does the turret tracking on moving ships hit other types?)
    addSquadron("TargetDestroyer0", "kus_destroyer", {4500, 0, 12000}, 1, {0, 180, 0}, 0, 0)
    createSOBGroup("TargetDestroyer")
    addToSOBGroup("TargetDestroyer0", "TargetDestroyer")
    addPoint("RangeFleeDestroyer_0", {4500, 0, 12000}, {0, 0, 0})
    addPoint("RangeFleeDestroyer_1", {4500, 0, 24000}, {0, 0, 0})
    addPath("RangeFleeDestroyerPath", "RangeFleeDestroyer_0", "RangeFleeDestroyer_1")

    -- a Kushan destroyer of the player's beside the Kuun-Lan: does a ship under a player's move order fire on the way?
    addSquadron("PlayerDestroyer0", "kus_destroyer", {-3000, 0, 2000}, 0, {0, 0, 0}, 0, 0)

    -- its flight for RANGE_CRUISER_STEP 4 (SobGroup_FollowPath takes a level path)
    addPoint("RangeFlee_0", {1500, 0, 12000}, {0, 0, 0})
    addPoint("RangeFlee_1", {1500, 0, 24000}, {0, 0, 0})
    addPath("RangeFleePath", "RangeFlee_0", "RangeFlee_1")
    addPoint("RangeFleeSound_0", {-1500, 0, 12000}, {0, 0, 0})
    addPoint("RangeFleeSound_1", {-1500, 0, 24000}, {0, 0, 0})
    addPath("RangeFleeSoundPath", "RangeFleeSound_0", "RangeFleeSound_1")

    addSphere("Everything", {0, 0, 0}, 30000)
    addCamera("Camera_Startpos", {0, 0, 2200}, {2200, 1600, -1200})
    setWorldBoundsInner({0, 0, 0}, {30000, 15000, 30000})
    setWorldBoundsOuter({0, 0, 0}, {36000, 18000, 36000})
end

function NonDetermChunk()
    fogSetActive(0)
    setGlareIntensity(0.0)
    setLevelShadowColour(0, 0, 0, 1)
    loadBackground("ez01")
    setSensorsManagerCameraDistances(10500, 87500)
end

maxPlayers = 4

player = {}
player[0] = { id = 0, name = "Somtaaw", resources = 50000, raceName = "Somtaaw", startPos = 0 }
player[1] = { id = 1, name = "Taiidan", resources = 0, raceName = "Taiidan", startPos = 1 }
player[2] = { id = 2, name = "Kushan", resources = 0, raceName = "Kushan", startPos = 0 }   -- empty: the ally slot (KAS_AllyPlayer)
player[3] = { id = 3, name = "Meteors", resources = 0, raceName = "Kushan", startPos = 0 }   -- the meteor belt
