-- Unit test range (hand-written, not from a Cataclysm mission): the Kuun-Lan, a few of each Somtaaw ship ported so
-- far, asteroids for the Workers and Taiidan targets at three distances. Script: range.lua.

function DetermChunk()
    addPoint("StartPos0", {0, 0, 0}, {0, 0, 0})
    addPoint("StartPos1", {0, 0, 9000}, {0, 180, 0})

    addSquadron("KuunLan", "smt_ms_sp", {0, 0, 0}, 0, {0, 0, 0}, 0, 0)
    -- strike craft in rows ahead of the Kuun-Lan (+Z)
    for i = 0, 7 do
        addSquadron("Acolyte" .. i, "smt_acolyte", {-700 + i * 200, 0, 2200}, 0, {0, 0, 0}, 0, 0)
    end
    createSOBGroup("Workers")
    for i = 0, 1 do
        addSquadron("ACV" .. i, "smt_acv", {-300 + i * 600, 0, 2600}, 0, {0, 0, 0}, 0, 0)
        addSquadron("Worker" .. i, "smt_worker", {-1800 + i * 400, 0, 1200}, 0, {0, 0, 0}, 0, 0)
        addToSOBGroup("Worker" .. i, "Workers")
    end
    -- the Processor (repair beams) to starboard, a Ramming Frigate beside the ACVs
    addSquadron("Processor0", "smt_processor", {1900, 0, 1200}, 0, {0, 0, 0}, 0, 0)
    addSquadron("RammingFrigate0", "smt_rammingfrigate", {1100, 0, 2600}, 0, {0, 0, 0}, 0, 0)
    -- tilted (pitch 20, yaw 50, roll 10): the orientation-matrix layout check in range.lua
    addSquadron("Recon0", "smt_scout", {0, 300, 2900}, 0, {20, 50, 10}, 0, 0)
    createSOBGroup("Recon")
    addToSOBGroup("Recon0", "Recon")

    -- asteroids off the port side
    for row = 0, 1 do
        for i = 0, 3 do
            addAsteroid("Asteroid2", {-4500 - i * 450, -200 + row * 400, 1500 + (row * 4 + i) * 250}, 400,
                        37 * i, 61 * row, 23 * i, 0)
        end
    end

    -- targets (player 1, its AI off): punching bags close, a strike group further out, frigates at long range
    addSquadron("TargetCollector0", "tai_resourcecollector", {1500, 0, 5000}, 1, {0, 180, 0}, 0, 0)
    addSquadron("TargetCollector1", "tai_resourcecollector", {2100, 0, 5000}, 1, {0, 180, 0}, 0, 0)
    for i = 0, 3 do
        addSquadron("TargetFighter" .. i, "tai_interceptor", {-2400 + i * 250, 0, 6500}, 1, {0, 180, 0}, 0, 0)
    end
    addSquadron("TargetCorvette0", "tai_heavycorvette", {-1300, 0, 6800}, 1, {0, 180, 0}, 0, 0)
    addSquadron("TargetCorvette1", "tai_lightcorvette", {-1000, 0, 6800}, 1, {0, 180, 0}, 0, 0)
    addSquadron("TargetFrigate0", "tai_assaultfrigate", {-500, 0, 9000}, 1, {0, 180, 0}, 0, 0)
    addSquadron("TargetFrigate1", "tai_ioncannonfrigate", {500, 0, 9000}, 1, {0, 180, 0}, 0, 0)
    createSOBGroup("TargetIon")
    addToSOBGroup("TargetFrigate1", "TargetIon")
    -- its 10 % damage copy (tools/make_variants.py), for the beam test in range.lua
    addSquadron("TargetFrigate2", "tai_ioncannonfrigate_d10", {1500, 0, 9000}, 1, {0, 180, 0}, 0, 0)
    createSOBGroup("TargetIon10")
    addToSOBGroup("TargetFrigate2", "TargetIon10")

    -- Mission01's crippled heavy cruiser (its 10 % damage copy) side by side with a sound one (range.lua
    -- RANGE_CRUISER_TEST: turret tracking at 20 % health, user)
    addSquadron("TargetCruiser0", "tai_heavycruiser_d10", {-1500, 0, 12000}, 1, {0, 180, 0}, 0, 0)
    createSOBGroup("TargetCruiserSound")
    addToSOBGroup("TargetCruiser0", "TargetCruiserSound")
    addSquadron("TargetCruiser1", "tai_heavycruiser_d10", {1500, 0, 12000}, 1, {0, 180, 0}, 0, 0)
    createSOBGroup("TargetCruiserCrippled")
    addToSOBGroup("TargetCruiser1", "TargetCruiserCrippled")

    -- a hostile Kushan destroyer flying the same way (user: does the turret tracking on moving ships hit other types?)
    addSquadron("TargetDestroyer0", "kus_destroyer", {4500, 0, 12000}, 1, {0, 180, 0}, 0, 0)
    createSOBGroup("TargetDestroyer")
    addToSOBGroup("TargetDestroyer0", "TargetDestroyer")
    addPoint("RangeFleeDestroyer_0", {4500, 0, 12000}, {0, 0, 0})
    addPoint("RangeFleeDestroyer_1", {4500, 0, 24000}, {0, 0, 0})
    addPath("RangeFleeDestroyerPath", "RangeFleeDestroyer_0", "RangeFleeDestroyer_1")

    -- a Kushan destroyer of the player's beside the Kuun-Lan: does a ship under a player's move order fire on the way?
    addSquadron("PlayerDestroyer0", "kus_destroyer", {-3000, 0, 2000}, 0, {0, 0, 0}, 0, 0)

    -- its flight for RANGE_CRUISER_STEP 4 (SobGroup_FollowPath takes a level path)
    addPoint("RangeFlee_0", {1500, 0, 12000}, {0, 0, 0})
    addPoint("RangeFlee_1", {1500, 0, 24000}, {0, 0, 0})
    addPath("RangeFleePath", "RangeFlee_0", "RangeFlee_1")
    addPoint("RangeFleeSound_0", {-1500, 0, 12000}, {0, 0, 0})
    addPoint("RangeFleeSound_1", {-1500, 0, 24000}, {0, 0, 0})
    addPath("RangeFleeSoundPath", "RangeFleeSound_0", "RangeFleeSound_1")

    addSphere("Everything", {0, 0, 0}, 30000)
    addCamera("Camera_Startpos", {0, 0, 2200}, {2200, 1600, -1200})
    setWorldBoundsInner({0, 0, 0}, {30000, 15000, 30000})
    setWorldBoundsOuter({0, 0, 0}, {36000, 18000, 36000})
end

function NonDetermChunk()
    fogSetActive(0)
    setGlareIntensity(0.0)
    setLevelShadowColour(0, 0, 0, 1)
    loadBackground("ez01")
    setSensorsManagerCameraDistances(10500, 87500)
end

maxPlayers = 2

player = {}
player[0] = { id = 0, name = "Somtaaw", resources = 50000, raceName = "Somtaaw", startPos = 0 }
player[1] = { id = 1, name = "Taiidan", resources = 0, raceName = "Taiidan", startPos = 1 }
